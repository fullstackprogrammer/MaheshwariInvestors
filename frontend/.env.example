# Backend API base URL (no trailing slash)
# `npm run dev` loads .env.development after this file — see that file for the local API URL.
# Local dev (backend on same machine): leave unset → same host as the Vite app, port 8080; or set explicitly:
# VITE_API_BASE_URL=http://localhost:8080
# Deployed frontend: your backend URL, e.g. https://api.maheshai.com or http://YOUR_EC2_IP:8000
# VITE_API_BASE_URL=http://YOUR_EC2_IP:8000